# Environment template for docker-compose.data-pipeline.yml
#
# Copy this file to .env in the same directory as the compose file, then replace
# every "changeme" value below with a real one:
#
#   cp .env.example .env
#
# NEVER COMMIT .env — it holds live credentials. Only this .example template is
# tracked in git (.gitignore excludes .env and re-includes .env.example).

# ===========================================================================
# Secrets — required by the compose stack. Replace all of these.
# ===========================================================================

# Airbyte's internal PostgreSQL password. Used by both airbyte-db (to
# initialise the database) and airbyte-server (in its DATABASE_URL).
# Generate one with: openssl rand -base64 32
AIRBYTE_DB_PASSWORD=changeme

# HashiCorp Vault address the masking engine resolves secrets from.
VAULT_ADDR=http://vault.internal:8200

# Vault token or AppRole credential for the masking engine.
# Generate/issue via your Vault instance; do not reuse a root token.
VAULT_TOKEN=changeme

# Seed for deterministic, consistent tokenization in the masking engine.
# Changing this value changes every token the engine produces, breaking
# referential integrity with previously masked data. Treat it as a long-lived
# secret and back it up. Generate with: openssl rand -hex 32
MASKING_MASTER_SEED=changeme

# ===========================================================================
# Pipeline tuning — optional, defaults shown.
# ===========================================================================

# Maximum number of pipeline runs executing concurrently.
PIPELINE_MAX_CONCURRENT=4

# Hours a pending human approval stays open before it is treated as expired.
APPROVAL_TIMEOUT_HOURS=24

# ===========================================================================
# Observability and notifications — optional. Leave blank to disable.
# ===========================================================================

# OpenTelemetry collector endpoint for traces and metrics.
OTLP_ENDPOINT=

# Webhook that receives pipeline notifications (failures, approvals required).
NOTIFICATION_WEBHOOK_URL=
