{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor-data.example.com/schemas/pipeline.schema.json",
  "title": "Conductor Data Pipeline Definition",
  "description": "JSON Schema for pipeline definition YAML (apiVersion: conductor-data/v1, kind: Pipeline)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "source", "targets"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "conductor-data/v1"
    },
    "kind": {
      "const": "Pipeline"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "created_by"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "brd_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["connector", "connection", "extraction"],
      "additionalProperties": false,
      "properties": {
        "connector": {
          "type": "string",
          "minLength": 1
        },
        "connection": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "integer" },
              { "type": "boolean" }
            ]
          }
        },
        "extraction": {
          "type": "object",
          "required": ["mode", "tables"],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["full", "incremental", "cdc"]
            },
            "cursor_field": {
              "type": "string"
            },
            "tables": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "filter": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "transform": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation"],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tier", "connector", "connection", "masking"],
        "additionalProperties": false,
        "properties": {
          "tier": {
            "type": "string",
            "minLength": 1
          },
          "connector": {
            "type": "string",
            "minLength": 1
          },
          "connection": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                { "type": "integer" },
                { "type": "boolean" }
              ]
            }
          },
          "masking": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "emit_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classification_audit": {
          "type": "boolean"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "on_failure": {
          "type": "string",
          "enum": ["block", "warn"]
        }
      }
    }
  }
}
